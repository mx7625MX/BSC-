# BSC RPC节点地址 (推荐使用可靠的节点服务)
BSC_RPC_URL=https://bsc-dataseed1.binance.org/

# 钱包私钥 (请务必保密，不要泄露)
PRIVATE_KEY=your_private_key_here

# PancakeSwap路由合约地址 (BSC主网)
PANCAKESWAP_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E

# PancakeSwap工厂合约地址
PANCAKESWAP_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73

# WBNB代币地址
WBNB_ADDRESS=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# 最小流动性要求 (BNB)
MIN_LIQUIDITY_BNB=5

# 最大购买金额 (BNB)
MAX_BUY_AMOUNT=0.1

# Gas价格倍数 (建议1.2-2.0，更高的Gas可以更快成交)
GAS_PRICE_MULTIPLIER=1.5

# Gas限制
GAS_LIMIT=500000

# 滑点容忍度 (百分比，例如10表示10%)
SLIPPAGE_TOLERANCE=10

# 监控间隔 (毫秒)
MONITOR_INTERVAL=1000

# 是否启用自动交易 (true/false)
AUTO_TRADE_ENABLED=false

# 代币黑名单 (用逗号分隔的地址列表)
TOKEN_BLACKLIST=

# 代币白名单 (如果设置，只交易白名单中的代币，用逗号分隔)
TOKEN_WHITELIST=

# 最小代币持有比例检查 (检测是否为蜜罐，百分比)
MIN_TOKEN_HOLDER_PERCENT=0.1

# 日志级别 (debug, info, warn, error)
LOG_LEVEL=info
