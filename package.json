{
  "name": "bsc-defensive-bot",
  "version": "1.0.0",
  "description": "A defensive bot for monitoring and managing BSC tokens with desktop GUI",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "node test.js"
  },
  "keywords": [
    "BSC",
    "blockchain",
    "bot",
    "web3",
    "electron",
    "trading"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "web3": "^4.3.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.bsc.defensivebot",
    "productName": "BSC Defensive Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
